{
  "name": "math251-fall2026-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run prepare:math",
    "dev": "vinext dev",
    "prebuild": "npm run prepare:math",
    "build": "vinext build",
    "prebuild:pages": "npm run prepare:math",
    "build:pages": "GITHUB_PAGES=true vinext build",
    "postbuild:pages": "GITHUB_PAGES=true node scripts/export-pages.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "ci": "npm run check && npm run build:pages && npm run verify:pages",
    "export:bb": "node scripts/export-blackboard.mjs && node scripts/blackboard/paste-test.mjs && node scripts/blackboard/notes.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings",
    "test": "node --test tests/*.test.ts",
    "prepare:math": "node scripts/sync-mathjax-fonts.mjs",
    "typecheck": "tsc --noEmit",
    "verify:pages": "node scripts/verify-pages.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/workers-types": "5.20260901.1",
    "@mdx-js/rollup": "3.1.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "mathjax-full": "3.2.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "rehype-mathjax": "7.1.0",
    "remark-math": "6.0.0",
    "shadcn": "4.18.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.127.1"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260828.1": true,
    "fsevents@2.3.3": true
  }
}
